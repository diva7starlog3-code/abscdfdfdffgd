// BAGAN LAMPU MOTOR ARDUINO
// ==============================

const int LED_KIRI_1  = 2;
const int LED_KIRI_2  = 3;
const int LED_KIRI_3  = 4;

const int LED_KANAN_1 = 5;
const int LED_KANAN_2 = 6;
const int LED_KANAN_3 = 7;

const int LED_TENGAH  = 8;

void setup() {
  pinMode(LED_KIRI_1, OUTPUT);
  pinMode(LED_KIRI_2, OUTPUT);
  pinMode(LED_KIRI_3, OUTPUT);

  pinMode(LED_KANAN_1, OUTPUT);
  pinMode(LED_KANAN_2, OUTPUT);
  pinMode(LED_KANAN_3, OUTPUT);

  pinMode(LED_TENGAH, OUTPUT);

  semuaMati();
}

void loop() {

  // Running dari kiri ke tengah
  digitalWrite(LED_KIRI_1, HIGH);
  delay(100);

  digitalWrite(LED_KIRI_2, HIGH);
  delay(100);

  digitalWrite(LED_KIRI_3, HIGH);
  delay(100);

  digitalWrite(LED_TENGAH, HIGH);
  delay(100);

  // Running dari tengah ke kanan
  digitalWrite(LED_KANAN_1, HIGH);
  delay(100);

  digitalWrite(LED_KANAN_2, HIGH);
  delay(100);

  digitalWrite(LED_KANAN_3, HIGH);
  delay(300);

  // Mati
  semuaMati();
  delay(200);
}

void semuaMati() {
  digitalWrite(LED_KIRI_1, LOW);
  digitalWrite(LED_KIRI_2, LOW);
  digitalWrite(LED_KIRI_3, LOW);

  digitalWrite(LED_KANAN_1, LOW);
  digitalWrite(LED_KANAN_2, LOW);
  digitalWrite(LED_KANAN_3, LOW);

  digitalWrite(LED_TENGAH, LOW);
}
