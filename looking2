* {
  box-sizing: border-box;
}

body {
  margin: 0;

  background:
    radial-gradient(circle at top, #202020, #080808);

  color: white;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


.container {

  width: 92%;
  max-width: 1100px;

  margin: auto;

  padding: 40px 0;
}


h1 {

  text-align: center;

  font-size: 34px;

  margin-bottom: 5px;
}


.subtitle {

  text-align: center;

  color: #999;

  margin-bottom: 40px;
}


section {

  background: #151515;

  border: 1px solid #333;

  border-radius: 20px;

  padding: 25px;

  margin-bottom: 25px;

  box-shadow:
    0 10px 30px rgba(0,0,0,.4);
}


h2 {

  margin-top: 0;

  text-align: center;

  font-size: 20px;
}


/* =========================
   FLOW
========================= */

.flow {

  display: flex;

  justify-content: center;

  align-items: center;

  flex-wrap: wrap;

  gap: 12px;
}


.component {

  min-width: 130px;

  padding: 18px;

  border-radius: 15px;

  text-align: center;

  background: #242424;

  border: 1px solid #444;

  transition: .3s;
}


.component:hover {

  transform: translateY(-4px);

  border-color: #777;
}


.icon {

  font-size: 30px;

  margin-bottom: 8px;
}


.component strong {

  display: block;
}


.component small {

  display: block;

  color: #999;

  margin-top: 5px;
}


.arrow {

  font-size: 30px;

  color: #888;
}


.down-arrow {

  text-align: center;

  font-size: 35px;

  margin: 15px;
}


.output-box {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 20px;

  flex-wrap: wrap;
}


/* =========================
   MOTOR LAMP
========================= */

.lamp-output {

  background: #090909;

  border: 3px solid #333;

  border-radius: 50px;

  padding: 25px;

  min-width: 500px;

  box-shadow:
    inset 0 0 30px #000;
}


.lamp-output > strong {

  display: block;

  text-align: center;

  margin-bottom: 20px;

  color: #aaa;
}


.motor-lamp {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 18px;
}


.lamp-side {

  text-align: center;
}


.label {

  display: block;

  font-size: 10px;

  color: #777;

  margin-bottom: 8px;
}


.led-row {

  display: flex;

  flex-direction: column;

  gap: 8px;
}


.led {

  width: 28px;

  height: 28px;

  display: block;

  border-radius: 50%;

  background: #171717;

  border: 2px solid #333;

  transition: .08s;
}


.led.on {

  background: #ffae00;

  border-color: #ffd15c;

  box-shadow:
    0 0 8px #ffae00,
    0 0 20px #ffae00,
    0 0 35px #ffae00;

  transform: scale(1.15);
}


.lamp-center {

  flex: 1;

  text-align: center;
}


.brake-row {

  display: flex;

  flex-direction: column;

  gap: 7px;
}


.brake-led {

  height: 15px;

  border-radius: 20px;

  background: #160000;

  border: 2px solid #411010;

  transition: .15s;
}


.brake-led.on {

  background: #ff1010;

  border-color: #ff6868;

  box-shadow:
    0 0 10px red,
    0 0 25px red,
    0 0 40px red;
}


/* =========================
   BUTTON
========================= */

.control {

  text-align: center;
}


.buttons {

  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap: 12px;

  margin: 25px 0;
}


button {

  padding: 15px 22px;

  border: 0;

  border-radius: 12px;

  background: #292929;

  color: white;

  font-weight: bold;

  cursor: pointer;

  transition: .2s;
}


button:hover {

  transform: translateY(-3px);

  background: #444;
}


button:active {

  transform: scale(.95);
}


button.off {

  background: #5d1515;
}


.status {

  margin-top: 20px;

  color: #888;
}


#status {

  color: white;

  font-weight: bold;
}


/* =========================
   INFO
========================= */

.info-grid {

  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(180px, 1fr));

  gap: 15px;
}


.info-grid div {

  background: #202020;

  padding: 18px;

  border-radius: 12px;
}


.info-grid b {

  color: #ffb300;
}


.info-grid p {

  color: #aaa;

  font-size: 14px;

  line-height: 1.5;
}


footer {

  text-align: center;

  color: #555;

  padding: 20px;
}


/* =========================
   HP
========================= */

@media(max-width: 650px) {

  h1 {
    font-size: 25px;
  }


  .lamp-output {

    min-width: 0;

    width: 100%;

    border-radius: 30px;
  }


  .motor-lamp {

    gap: 8px;
  }


  .component {

    width: 100%;
  }


  .arrow {

    transform: rotate(90deg);
  }

}
